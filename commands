# SIMULACIÓN CON ERRORES

# Equivalente al tbt-simulator
$python_exec $home_dir/simulateSystem.py -s err \
		-C \
		-cf $config_file \
		-id inputs/lattices/lhc/lhcCardona.madx \
		-od outputs/errors/ \
		-ef inputs/IR_errors.madx \
		-n 100	\
		-b 1

# Equivalente al ActionPhaseJump: calcula APJ y el avermax
$python_exec $home_dir/calculateAPJ.py -s err \
		-C \
		-cf $config_file \
		-sf outputs/errors/E_track.parquet \
		-md outputs/nominal/nominal_measurements_twiss.parquet \
		-od outputs/errors/APJ/ \
		-ab bpmsw.1l1.b1 \



# -------------------- 
# CORREGIR EL SISTEMA 

# Equivalente a las correcciones halladas en ActionPhaseJump
$python_exec $home_dir/calculateCorrections.py \
		-C \
		-cf $config_file \
		-id outputs/errors/APJ \
		-md outputs/nominal \
		-ef inputs/IR_errors+corrections.madx \



# -----------------------
# SIMULACIÓN CON CORRECCIONES

# Equivalente al tbt-simulator
$python_exec $home_dir/simulateSystem.py -s corr \
		-C \
		-cf $config_file \
		-id inputs/lattices/lhc/lhcCardona.madx \
		-od outputs/corrections/ \
		-ef inputs/IR_errors+corrections.madx \
		-n 100	\
		-b 1

# Equivalente al ActionPhaseJump: calcula APJ y el avermax
$python_exec $home_dir/calculateAPJ.py -s corr \
		-C \
		-cf $config_file \
		-sf outputs/corrections/C_track.parquet \
		-md outputs/nominal/nominal_measurements_twiss.parquet \
		-od outputs/corrections/APJ/ \
